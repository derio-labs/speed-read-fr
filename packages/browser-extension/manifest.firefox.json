{
  "manifest_version": 3,
  "name": "Speed Read",
  "version": "0.1.0",
  "description": "A structure-aware speed reader for web pages and chat replies. Works offline.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Speed read (Alt+Shift+R)", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "speed-read@speed-read-fr", "strict_min_version": "128.0" } },
  "commands": {
    "speed-read": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Speed read the selection, else the main content" }
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
